{
  "env": {
    "node": true,
    "es6": true
  },
  "parser": "babel-eslint",
  "parserOptions": {
    "sourceType": "module",
    "allowImportExportEverywhere": false,
    "codeFrame": false
  },
  "globals": {},
  "rules": {
    "quotes": [2, "single", {"allowTemplateLiterals":true}],
    "curly": [2, "all"],
    "eqeqeq": 2,
    "guard-for-in": 2,
    "wrap-iife": 2,
    "no-use-before-define": 2,
    "new-cap": 2,
    "no-empty": 2,
    "no-irregular-whitespace": 2,
    "no-unused-vars": 2,
    "strict": [2, "global"],
    "max-depth": [2, 3],
    "max-len": [2, 80],
    "brace-style": 2,
    "no-with": 2,
    "no-mixed-spaces-and-tabs": 2,
    "no-multiple-empty-lines": 2,
    "no-multi-str": 2,
    "one-var": [2, {"initialized": "never"}],
    "padded-blocks": [2, "never"],
    "space-unary-ops": [2, {
      "words": false,
      "nonwords": false}
    ],
    "no-spaced-func": 2,
    "comma-dangle": [2, "never"],
    "no-trailing-spaces": 2,
    "yoda": [2, "never"],
    "eol-last": 2,
    "spaced-comment": [2, "always"],
    "indent": [2, 2, {"SwitchCase": 1}],
    "linebreak-style": [2, "unix"],
    "semi": [2, "always"]
  }
}
