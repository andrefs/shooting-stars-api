{
  "name": "shooting-stars-api",
  "version": "4.0.0",
  "description": "API for the Shooting Stars game",
  "main": "index.js",
  "scripts": {
    "dev:initdb": "mongofixtures shooting-stars-imageless scripts/db_fixtures_dev.js",
    "dev:dropdb": "mongo         shooting-stars-imageless --eval 'db.dropDatabase();'",
    "start": "node index.js",
    "test": "NODE_ENV=test npm run test-unit",
    "test-unit": "NODE_ENV=test nyc -n models/**/*.js mocha --require babel-register test/unit/*.test.js",
    "test-integration": "NODE_ENV=test nyc -n routes/**/*.js mocha --require babel-register test/integration/*.test.js",
    "test:watch": "nodemon --watch lib --watch models --watch routes --watch test --exec 'npm test'",
    "prod:cron": "NODE_ENV=production pm2 start --name \"ss-api rebuild-cron\" scripts/rebuild-order.js --cron \"* * * * *\"",
    "prod:cluster": "NODE_ENV=production pm2 start -i -1 index.js --name=\"ss-api\"",
    "lint": "eslint **/*.js || exit 0"
  },
  "babel": {
    "sourceMaps": "inline",
    "presets": [
      [
        "env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ],
    "plugins": [
      [
        "babel-plugin-transform-builtin-extend",
        {
          "globals": [
            "Error",
            "Array"
          ]
        }
      ]
    ]
  },
  "engines": {
    "node": ">=10.1.0"
  },
  "author": "André Santos",
  "license": "ISC",
  "dependencies": {
    "avl-promise": "^0.1.0",
    "babel-plugin-transform-builtin-extend": "1.1.2",
    "babel-preset-env": "^1.7.0",
    "babel-register": "^6.24.1",
    "bases": "^0.2.1",
    "bcrypt": "^2.0.1",
    "bluebird": "^3.5.0",
    "bunyan-winston-adapter": "^0.2.0",
    "got": "^9.0.0",
    "inherits": "^2.0.3",
    "jimp": "^0.5.6",
    "jwt-simple": "^0.5.1",
    "lobo-mongodb-fixtures": "^1.0.0",
    "lodash": "^4.17.5",
    "md5": "^2.2.1",
    "mongodb": "^3.1.0-beta4",
    "mongoose": "^5.1.1",
    "mongoose-api-query": "^0.1.1-pre",
    "mongoose-createdmodified": "^0.0.2",
    "mongoose-paginate": "^5.0.3",
    "mongoose-sequence": "^4.0.0",
    "mongoose-type-url": "^1.0.2",
    "morgan": "1.9.0",
    "node-avl-tree": "^0.1.1",
    "passport": "^0.4.0",
    "passport-custom": "^1.0.5",
    "passport-local": "^1.0.0",
    "restify": "^7.1.2",
    "restify-cors-middleware": "^1.1.0",
    "restify-errors": "^6.0.0",
    "restify-jwt-community": "^1.0.7",
    "sinon-chai": "^3.0.0",
    "sinon-mongoose": "^2.0.2",
    "uuid": "^3.2.1",
    "winston": "^3.0.0"
  },
  "devDependencies": {
    "babel-core": "^6.24.1",
    "babel-eslint": "^8.2.1",
    "chai": "^4.1.2",
    "chai-as-promised": "^7.1.1",
    "mocha": "^5.0.0",
    "nodemon": "^1.17.4",
    "nyc": "^11.7.3",
    "sinon": "^5.0.7",
    "source-map-support": "^0.5.6",
    "supertest": "^3.1.0"
  }
}
