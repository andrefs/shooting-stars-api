{
  "name": "shooting-stars-api",
  "version": "6.0.0",
  "description": "API for the Shooting Stars game",
  "main": "index.js",
  "scripts": {
    "dev:initdb": "mongodb-fixtures load -u mongodb://127.0.0.1:27017/shooting-stars-imageless --path ./fixtures",
    "dev:dropdb": "mongodb-fixtures unload -u mongodb://127.0.0.1:27017/shooting-stars-imageless",
    "start": "node index.js",
    "test": "NODE_ENV=test npm run test-unit",
    "test-unit": "NODE_ENV=test jest --runInBand test/unit/*.test.js",
    "test-integration": "NODE_ENV=test nyc -n routes/**/*.js mocha --require babel-register test/integration/*.test.js",
    "test:watch": "nodemon --watch lib --watch models --watch routes --watch test --exec 'npm test'",
    "prod:cron": "NODE_ENV=production pm2 start --name \"ss-api rebuild-cron\" scripts/rebuild-order.js --cron \"* * * * *\"",
    "prod:cluster": "NODE_ENV=production pm2 start -i -1 index.js --name=\"ss-api\"",
    "lint": "eslint **/*.js || exit 0"
  },
  "type": "module",
  "babel": {
    "sourceMaps": "inline",
    "presets": [
      [
        "env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ],
    "plugins": [
      [
        "babel-plugin-transform-builtin-extend",
        {
          "globals": [
            "Error",
            "Array"
          ]
        }
      ]
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "author": "André Santos",
  "license": "ISC",
  "dependencies": {
    "avl-promise": "^0.1.1",
    "babel-plugin-transform-builtin-extend": "1.1.2",
    "babel-preset-env": "^1.7.0",
    "babel-register": "^6.26.0",
    "bases": "^0.2.1",
    "bcrypt": "5.1.0",
    "bluebird": "^3.7.2",
    "bunyan-winston-adapter": "^0.2.0",
    "got": "^12.5.3",
    "inherits": "^2.0.4",
    "jimp": "^0.22.4",
    "jwt-simple": "^0.5.6",
    "knuth-shuffle": "^1.0.8",
    "lodash": "^4.17.21",
    "md5": "^2.3.0",
    "mongoose": "7.0.2",
    "mongoose-createdmodified": "^0.0.2",
    "mongoose-paginate": "^5.0.3",
    "mongoose-sequence": "5.3.1",
    "morgan": "1.10.0",
    "node-mongodb-fixtures": "3.2.9",
    "passport": "^0.6.0",
    "passport-custom": "^1.1.1",
    "passport-local": "^1.0.0",
    "restify": "10.0.0",
    "restify-cors-middleware2": "2.2.0",
    "restify-errors": "6.1.1",
    "restify-jwt-community": "^1.1.29",
    "uuid": "^9.0.0",
    "winston": "^3.8.2"
  },
  "devDependencies": {
    "babel-eslint": "^8.2.1",
    "jest": "29.4.3",
    "mocha": "^10.2.0",
    "nodemon": "^2.0.20",
    "nyc": "^15.1.0"
  }
}
