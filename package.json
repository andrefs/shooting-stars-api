{
  "name": "shooting-stars-api",
  "version": "0.0.1",
  "description": "API for the Shooting Stars game",
  "main": "index.js",
  "scripts": {
    "dev:initdb": "mongofixtures shooting-stars-dev scripts/db_fixtures_dev.js",
    "dev:dropdb": "mongo shooting-stars-dev --eval 'db.dropDatabase();'",
    "start": "node index.js",
    "test": "npm run test-unit",
    "test-unit": "NODE_ENV=test nyc -n models/**/*.js mocha --require babel-register test/unit/*.test.js",
    "test-integration": "NODE_ENV=test nyc -n routes/**/*.js mocha --require babel-register test/integration/*.test.js",
    "lint": "eslint **/*.js || exit 0"
  },
  "babel": {
    "sourceMaps": "inline",
    "presets": [
      "env"
    ],
    "plugins": [
      [
        "babel-plugin-transform-builtin-extend",
        {
          "globals": [
            "Error",
            "Array"
          ]
        }
      ]
    ]
  },
  "engines": {
    "node": ">=8.6.0"
  },
  "author": "André Santos",
  "license": "ISC",
  "dependencies": {
    "babel-plugin-transform-builtin-extend": "1.1.2",
    "babel-preset-env": "^1.6.1",
    "babel-register": "^6.24.1",
    "bases": "^0.2.1",
    "bcrypt": "^1.0.2",
    "bluebird": "^3.5.0",
    "bunyan-winston-adapter": "^0.2.0",
    "foreach-combination": "^1.0.0",
    "inherits": "^2.0.3",
    "jwt-simple": "^0.5.1",
    "lobo-mongodb-fixtures": "^1.0.0",
    "lodash": "^4.17.4",
    "mongoose": "4.12.3",
    "mongoose-api-query": "^0.1.1-pre",
    "mongoose-createdmodified": "^0.0.2",
    "mongoose-paginate": "^5.0.3",
    "mongoose-sequence": "^4.0.0",
    "mongoose-type-url": "^1.0.2",
    "morgan": "1.9.0",
    "passport": "^0.4.0",
    "passport-local": "^1.0.0",
    "restify": "^6.0.1",
    "restify-errors": "^5.0.0",
    "restify-jwt": "github:amrav/restify-jwt",
    "sinon-mongoose": "2.0.2",
    "uuid": "^3.1.0",
    "winston": "^2.3.1"
  },
  "devDependencies": {
    "babel-core": "^6.24.1",
    "babel-eslint": "^8.0.1",
    "chai": "^4.1.2",
    "chai-as-promised": "^7.1.1",
    "mocha": "^4.0.1",
    "nyc": "11.2.1",
    "sinon": "^4.0.1",
    "supertest": "3.0.0"
  }
}
